PORT=8000
MONGO_URI=your_mongodb_connection_string_here
JWT_SECRET=expense_tracker_secret

# Example standard Atlas URI format (if mongodb+srv causes DNS issues):
# mongodb://username:password@cluster0-shard-00-00.xxx.mongodb.net:27017,cluster0-shard-00-01.xxx.mongodb.net:27017,cluster0-shard-00-02.xxx.mongodb.net:27017/expense-tracker?ssl=true&replicaSet=atlas-xxxxx-shard-0&authSource=admin&retryWrites=true&w=majority
